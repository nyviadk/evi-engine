{
  "name": "evi-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/check-prismic-guards.mjs && next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "lint": "node scripts/check-prismic-guards.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "check:prismic-guards": "node scripts/check-prismic-guards.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "evi:sync-slices": "tsx scripts/sync-slices.ts",
    "evi:preview-slices": "node scripts/preview-slices.mjs",
    "evi:new-slice": "node scripts/new-slice.mjs",
    "evi:model": "node scripts/model-sync.mjs",
    "evi:login": "prismic login",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && cross-env OPEN_NEXT_DEPLOY=true wrangler deploy",
    "deploy:clean": "npx rimraf .next .open-next && opennextjs-cloudflare build && cross-env OPEN_NEXT_DEPLOY=true wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || exit 0"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.2",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/utils": "^3.1.4",
    "@opennextjs/cloudflare": "^1.20.1",
    "@prismicio/client": "^7.21.8",
    "@prismicio/next": "^2.2.4",
    "@prismicio/react": "^3.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "negotiator": "^1.0.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@slicemachine/adapter-next": "^0.3.96",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-tailwindcss": "^4.0.3",
    "ora": "^9.3.0",
    "p-limit": "^7.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "schema-dts": "^2.0.0",
    "slice-machine-ui": "^2.21.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  }
}
