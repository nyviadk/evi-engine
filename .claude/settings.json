{
  "permissions": {
    "allow": [
      "Bash(node scripts/check-prismic-guards.mjs)",
      "Bash(echo \"---exit:$?---\")",
      "Bash(echo \"---eslint-exit:$?---\")",
      "Bash(echo \"---tsc-exit:$?---\")",
      "Bash(echo \"---tsc:$?---\")",
      "Bash(echo \"---eslint:$?---\")",
      "Bash(echo \"tsc:$?\")",
      "Bash(echo \"eslint:$?\")",
      "Bash(python -c \"import json; json.load\\(open\\('slices/Maps/model.json'\\)\\); print\\('JSON gyldig'\\)\")",
      "Bash(echo \"TSC_EXIT=$?\")",
      "Bash(echo \"ESLINT_EXIT=$?\")",
      "Bash(grep -vE '^[+-][[:space:]]*\\(//|/\\\\*|\\\\*|\\\\{/\\\\*|.*\\\\*/|\\\\{\\)')",
      "Bash(grep -vE '^[+-][[:space:]]*$')"
    ],
    "deny": [
      "Bash(npm run deploy*)",
      "Bash(npm run upload*)",
      "Bash(npm run preview*)",
      "Bash(npm run evi:sync-slices*)",
      "Bash(opennextjs-cloudflare *)",
      "Bash(npx opennextjs-cloudflare *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -Eq 'npm run (deploy|upload|preview)|evi:sync-slices|opennextjs-cloudflare (deploy|build|preview|upload)'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked by project policy: production deploy (deploy/upload/preview, opennextjs-cloudflare) and tenant sync-slices are user-only. Claude must never run these.\"}}'; fi",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
