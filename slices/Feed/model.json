        },
        "body": {
          "config": {
            "label": "Brødtekst",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "heading_align": {
          "config": {
            "default_value": "Venstre",
            "label": "Overskrift-justering",
