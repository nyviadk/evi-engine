{
  "id": "feed",
  "name": "Feed",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "",
      "id": "default",
      "imageUrl": "https://images.prismic.io/evi-engine/shared-slices/feed/default/ea703221250fcec384290d6228d7c6b668a3257d.png?auto=compress%2Cformat",
      "name": "Default",
      "primary": {
        "heading": {
          "config": {
            "label": "Overskrift",
            "single": "heading2,strong,em"
          },
          "type": "StructuredText"
        },
        "body": {
          "config": {
            "label": "Brødtekst",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "heading_align": {
          "config": {
            "default_value": "Venstre",
            "label": "Overskrift-justering",
            "options": [
              "Venstre",
              "Centreret"
            ]
          },
          "type": "Select"
        },
        "parent_page": {
          "config": {
            "customtypes": [
              "page"
            ],
            "label": "Vis undersider af",
            "select": "document"
          },
          "type": "Link"
        },
        "posts": {
          "config": {
            "fields": {
              "date": {
                "config": {
                  "label": "Dato"
                },
                "type": "Date"
              },
              "topic": {
                "config": {
                  "label": "Emne (til filtrene)",
                  "placeholder": "fx Støtte"
                },
                "type": "Text"
              },
              "text": {
                "config": {
                  "label": "Tekst",
                  "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
                },
                "type": "StructuredText"
              },
              "image": {
                "config": {
                  "label": "Billede (valgfrit)"
                },
                "type": "Image"
              },
              "url": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Link til opslaget",
                  "select": "web"
                },
                "type": "Link"
              }
            },
            "label": "LinkedIn-opslag"
          },
          "type": "Group"
        },
        "limit": {
          "config": {
            "label": "Maks. antal kort",
            "min": 1,
            "placeholder": "Tom = alle"
          },
          "type": "Number"
        },
        "show_date": {
          "config": {
            "default_value": false,
            "label": "Dato på kortene",
            "placeholder_false": "Skjul dato",
            "placeholder_true": "Vis dato"
          },
          "type": "Boolean"
        },
        "show_filters": {
          "config": {
            "default_value": false,
            "label": "Filtre ud fra tags",
            "placeholder_false": "Skjul filtre",
            "placeholder_true": "Vis filtre"
          },
          "type": "Boolean"
        },
        "card_cta": {
          "config": {
            "label": "Kortets link-tekst",
            "placeholder": "fx Læs artikel"
          },
          "type": "Text"
        },
        "filter_legend": {
          "config": {
            "label": "Filtre: overskrift",
            "placeholder": "fx Emne (læses op af skærmlæsere)"
          },
          "type": "Text"
        },
        "filter_all": {
          "config": {
            "label": "Filtre: alle",
            "placeholder": "fx Alle"
          },
          "type": "Text"
        },
        "filter_status": {
          "config": {
            "label": "Filtre: antal",
            "placeholder": "fx {antal} indlæg"
          },
          "type": "Text"
        },
        "cta_link": {
          "config": {
            "allowText": true,
            "label": "Knap under kortene (valgfri)"
          },
          "type": "Link"
        },
        "background_theme": {
          "config": {
            "default_value": "Lys",
            "label": "Baggrundstema",
            "options": [
              "Lys",
              "Mørk",
              "Primær",
              "Sekundær",
              "Mørk blød",
              "Primær blød",
              "Sekundær blød"
            ]
          },
          "type": "Select"
        },
        "author_name": {
          "config": {
            "label": "Opslag: afsender",
            "placeholder": "fx Sebastian & Yannik"
          },
          "type": "Text"
        },
        "author_image_1": {
          "config": {
            "label": "Opslag: afsenderbillede 1"
          },
          "type": "Image"
        },
        "author_image_2": {
          "config": {
            "label": "Opslag: afsenderbillede 2"
          },
          "type": "Image"
        },
        "post_more": {
          "config": {
            "label": "Opslag: vis mere",
            "placeholder": "fx Vis hele opslaget"
          },
          "type": "Text"
        },
        "post_less": {
          "config": {
            "label": "Opslag: vis mindre",
            "placeholder": "fx Vis mindre"
          },
          "type": "Text"
        },
        "post_link_label": {
          "config": {
            "label": "Opslag: link-tekst",
            "placeholder": "fx Deltag i samtalen på LinkedIn"
          },
          "type": "Text"
        }
      },
      "version": ""
    }
  ]
}