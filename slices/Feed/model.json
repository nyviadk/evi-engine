          },
          "type": "Link"
        },
        "background_theme": {
          "config": {
            "default_value": "Lys",
            "label": "Baggrundstema",
            "options": [
              "Lys",
              "Mørk",
              "Primær",
              "Sekundær",
              "Mørk blød",
              "Primær blød",
              "Sekundær blød"
            ]
          },
          "type": "Select"
        }
      },
      "version": ""
    }
