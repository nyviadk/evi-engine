            "placeholder": "Tom = alle"
          },
          "type": "Number"
        },
        "show_date": {
          "config": {
            "default_value": false,
            "label": "Dato på kortene",
            "placeholder_false": "Skjul dato",
            "placeholder_true": "Vis dato"
          },
          "type": "Boolean"
        },
        "show_filters": {
          "config": {
            "default_value": false,
            "label": "Filtre ud fra tags",
            "placeholder_false": "Skjul filtre",
            "placeholder_true": "Vis filtre"
          },
          "type": "Boolean"
        },
        "card_cta": {
          "config": {
            "label": "Kortets link-tekst",
            "placeholder": "fx Læs artikel"
          },
          "type": "Text"
        },
        "filter_legend": {
          "config": {
            "label": "Filtre: overskrift",
            "placeholder": "fx Emne (læses op af skærmlæsere)"
          },
          "type": "Text"
        },
        "filter_all": {
          "config": {
            "label": "Filtre: alle",
            "placeholder": "fx Alle"
          },
          "type": "Text"
        },
        "filter_status": {
          "config": {
            "label": "Filtre: antal",
            "placeholder": "fx {antal} indlæg"
          },
          "type": "Text"
        },
        "cta_link": {
          "config": {
            "allowText": true,
