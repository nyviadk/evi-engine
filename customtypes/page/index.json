{
  "id": "page",
  "label": "Side",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Sti (f.eks. om-os)"
        }
      },
      "parent_page": {
        "type": "Link",
        "config": {
          "label": "Forældre side",
          "select": "document",
          "customtypes": [
            "page"
          ],
          "repeat": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "hero": {
              "type": "SharedSlice"
            },
            "features": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "highlights": {
              "type": "SharedSlice"
            },
            "phone_mockup": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "SEO titel",
          "placeholder": "Vises i Google og i browser-fanen"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "SEO beskrivelse",
          "placeholder": "Den lille tekst der vises under linket i Google"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Billede (Sociale Medier)",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      },
      "noindex": {
        "type": "Boolean",
        "config": {
          "label": "Skjul siden fra Google (noindex)",
          "default_value": false,
          "placeholder_true": "Skjult fra Google",
          "placeholder_false": "Synlig i Google"
        }
      },
      "canonical_override": {
        "type": "Text",
        "config": {
          "label": "Canonical URL (avanceret)",
          "placeholder": "Kun hvis siden skal pege på en anden URL i Google"
        }
      }
    }
  },
  "status": true,
  "format": "page"
}