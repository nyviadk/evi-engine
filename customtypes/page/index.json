{
  "format": "page",
  "id": "page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "URL Sti (f.eks. om-os)"
        },
        "type": "UID"
      },
      "parent_page": {
        "config": {
          "customtypes": [
            "page"
          ],
          "label": "Forældre side",
          "repeat": false,
          "select": "document"
        },
        "type": "Link"
      },
      "slices": {
        "config": {
          "choices": {
            "hero": {
              "type": "SharedSlice"
            },
            "features": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "highlights": {
              "type": "SharedSlice"
            },
            "phone_mockup": {
              "type": "SharedSlice"
            },
            "testimonials": {
              "type": "SharedSlice"
            },
            "text_with_images": {
              "type": "SharedSlice"
            },
            "case_studies": {
              "type": "SharedSlice"
            },
            "prices": {
              "type": "SharedSlice"
            },
            "gallery": {
              "type": "SharedSlice"
            },
            "maps": {
              "type": "SharedSlice"
            },
            "profile": {
              "type": "SharedSlice"
            },
            "text_content": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "SEO titel",
          "placeholder": "Vises i Google og i browser-fanen"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "SEO beskrivelse",
          "placeholder": "Den lille tekst der vises under linket i Google"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "label": "Billede (Sociale Medier)",
          "thumbnails": []
        },
        "type": "Image"
      },
      "noindex": {
        "config": {
          "default_value": false,
          "label": "Skjul siden fra Google (noindex)",
          "placeholder_false": "Synlig i Google",
          "placeholder_true": "Skjult fra Google"
        },
        "type": "Boolean"
      },
      "canonical_override": {
        "config": {
          "label": "Canonical URL (avanceret)",
          "placeholder": "Kun hvis siden skal pege på en anden URL i Google"
        },
        "type": "Text"
      }
    }
  },
  "label": "Side",
  "repeatable": true,
  "status": true
}