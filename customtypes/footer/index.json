{
  "format": "custom",
  "id": "footer",
  "json": {
    "Main": {
      "logo": {
        "config": {
          "constraint": {
            "height": 48,
            "width": null
          },
          "label": "Logo",
          "placeholder": "Valgfri — 48px høj, fri bredde. Tom = sitenavn som tekst",
          "thumbnails": []
        },
        "type": "Image"
      },
      "info_text": {
        "config": {
          "label": "Virksomhedstekst",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
          "placeholder": "Kort tekst under logo (fx tagline eller mission)"
        },
        "type": "StructuredText"
      },
      "columns": {
        "config": {
          "choices": {
            "footer_column_links": {
              "type": "SharedSlice"
            },
            "footer_column_text": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Kolonner",
        "type": "Slices"
      },
      "copyright": {
        "config": {
          "allowTargetBlank": true,
          "label": "Copyright-navn",
          "placeholder": "fx Firmanavn — © og år tilføjes automatisk",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "legal_links": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "Juridiske links",
          "repeat": true
        },
        "type": "Link"
      },
      "language_selector": {
        "config": {
          "default_value": "Slået fra",
          "label": "Sprogvælger",
          "options": [
            "Slået fra",
            "Slået til"
          ],
          "placeholder": "Vises kun hvis tenant har flere sprog"
        },
        "type": "Select"
      },
      "background_theme": {
        "config": {
          "default_value": "Lys",
          "label": "Baggrundstema",
          "options": [
            "Lys",
            "Mørk",
            "Primær",
            "Sekundær",
            "Mørk blød",
            "Primær blød",
            "Sekundær blød"
          ],
          "placeholder": "Baggrundstema for hele footeren"
        },
        "type": "Select"
      }
    }
  },
  "label": "Footer",
  "repeatable": false,
  "status": true
}