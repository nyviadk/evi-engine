{
  "format": "custom",
  "id": "business",
  "json": {
    "Stamdata": {
      "schema_type": {
        "config": {
          "label": "Virksomhedstype",
          "options": [
            "Organization",
            "LocalBusiness",
            "Person",
            "Corporation"
          ],
          "placeholder": "Vælg type..."
        },
        "type": "Select"
      },
      "legal_name": {
        "config": {
          "label": "Juridisk navn",
          "placeholder": "Skal matche evt. CVR"
        },
        "type": "Text"
      },
      "alternate_name": {
        "config": {
          "label": "Alternativt navn",
          "placeholder": "F.eks. forkortelse"
        },
        "type": "Text"
      },
      "vat_id": {
        "config": {
          "label": "CVR Nummer",
          "placeholder": "F.eks. 12345678"
        },
        "type": "Text"
      },
      "brand_logo": {
        "config": {
          "label": "Logo (Min. 112x112px, hvid bg)",
          "thumbnails": []
        },
        "type": "Image"
      },
      "description": {
        "config": {
          "label": "Kort beskrivelse",
          "placeholder": "En ultrakort, faktuel beskrivelse af virksomheden..."
        },
        "type": "Text"
      }
    },
    "Kontakt & social": {
      "contact_email": {
        "config": {
          "label": "Global email",
          "placeholder": "F.eks. kontakt@virksomhed.dk"
        },
        "type": "Text"
      },
      "global_telephone": {
        "config": {
          "label": "Global telefon",
          "placeholder": "F.eks. +45 12 34 56 78"
        },
        "type": "Text"
      },
      "social_profiles": {
        "config": {
          "fields": {
            "platform": {
              "config": {
                "label": "Platform",
                "options": [
                  "LinkedIn",
                  "Facebook",
                  "Instagram",
                  "YouTube",
                  "X",
                  "Wikipedia"
                ],
                "placeholder": "Vælg medie..."
              },
              "type": "Select"
            },
            "profile_url": {
              "config": {
                "label": "Profil URL",
                "placeholder": "https://linkedin.com/company/dit-brand"
              },
              "type": "Text"
            }
          },
          "label": "Sociale profiler (sameAs)",
          "repeat": true
        },
        "type": "Group"
      }
    },
    "Avanceret SEO": {
      "schema_mode": {
        "config": {
          "default_value": "Auto (Virksomhed + Brødkrummer)",
          "label": "Schema mode (Kill Switch)",
          "options": [
            "Auto (Virksomhed + Brødkrummer)",
            "Kun brødkrummer",
            "Deaktiver alt (kun Custom JSON)"
          ],
          "placeholder": ""
        },
        "type": "Select"
      },
      "custom_schema_json": {
        "config": {
          "label": "Custom JSON-LD (Power User)",
          "placeholder": "Indsæt valid JSON-LD kode her. Brug kun hvis du ved, hvad du laver!"
        },
        "type": "Text"
      },
      "faq_schema": {
        "config": {
          "default_value": "Ja",
          "label": "FAQ-schema (Bing + AI-svarmaskiner)",
          "options": [
            "Ja",
            "Nej"
          ]
        },
        "type": "Select"
      }
    }
  },
  "label": "Business",
  "repeatable": false,
  "status": true
}