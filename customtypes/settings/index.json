{
  "format": "custom",
  "id": "settings",
  "json": {
    "Generelt": {
      "site_name": {
        "config": {
          "label": "Sidenavn",
          "placeholder": "F.eks. Jensen Frisør"
        },
        "type": "Text"
      },
      "force_lang_prefix": {
        "config": {
          "default_value": false,
          "label": "Tving sprog i URL? (fx /da-dk)",
          "placeholder_false": "Nej",
          "placeholder_true": "Ja"
        },
        "type": "Boolean"
      },
      "default_og_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Standard billede (sociale medier)",
          "thumbnails": []
        },
        "type": "Image"
      },
      "favicon_light": {
        "config": {
          "constraint": {
            "height": 512,
            "width": 512
          },
          "label": "Favicon — mørkt ikon (til lyst tema)",
          "placeholder": "Mørk streg/logo — vises på browserens LYSE faneblad",
          "thumbnails": []
        },
        "type": "Image"
      },
      "favicon_dark": {
        "config": {
          "constraint": {
            "height": 512,
            "width": 512
          },
          "label": "Favicon — lyst ikon (til mørkt tema)",
          "placeholder": "Lys streg/logo — vises på browserens MØRKE faneblad",
          "thumbnails": []
        },
        "type": "Image"
      },
      "timezone": {
        "config": {
          "default_value": "Europe/Copenhagen",
          "label": "Tidszone",
          "options": [
            "Europe/Copenhagen",
            "Europe/Oslo",
            "Europe/Stockholm",
            "Europe/Helsinki",
            "Europe/Berlin",
            "Europe/London",
            "UTC"
          ],
          "placeholder": "Kundens tidszone"
        },
        "type": "Select"
      },
      "translate_brand": {
        "config": {
          "label": "Tillad oversættelse af sitenavn (fx Google Translate)",
          "placeholder_false": "Bevar originalt navn",
          "placeholder_true": "Tillad oversættelse"
        },
        "type": "Boolean"
      }
    },
    "Udseende og layout": {
      "color_light": {
        "config": {
          "label": "Lys farve",
          "placeholder": ""
        },
        "type": "Color"
      },
      "color_dark": {
        "config": {
          "label": "Mørk farve",
          "placeholder": ""
        },
        "type": "Color"
      },
      "color_primary": {
        "config": {
          "label": "Primær brandfarve",
          "placeholder": ""
        },
        "type": "Color"
      },
      "color_secondary": {
        "config": {
          "label": "Sekundær brandfarve",
          "placeholder": ""
        },
        "type": "Color"
      },
      "layout_width": {
        "config": {
          "label": "Layoutbredde",
          "options": [
            "Klassisk (1200px)",
            "Standard (1280px)",
            "Komfort (1360px)",
            "Moderne (1440px)",
            "Ekspansiv (1664px)",
            "Cinematic (1920px)"
          ],
          "placeholder": "Bredden på dit hjemmesideindhold"
        },
        "type": "Select"
      },
      "border_radius": {
        "config": {
          "label": "Hjørner / radius",
          "options": [
            "Skarpe hjørner (0px)",
            "Lille afrunding (4px)",
            "Standard (8px)",
            "Blød (16px)",
            "Pilleformet (fuld radius)"
          ],
          "placeholder": "Hvor skarpe eller bløde kanterne skal være på fx kasser og billeder"
        },
        "type": "Select"
      },
      "font_select": {
        "config": {
          "default_value": "System standard",
          "label": "Skrifttype (anbefalet - hurtig)",
          "options": [
            "System standard",
            "Montserrat",
            "Rethink Sans",
            "Comfortaa",
            "Poppins",
            "Abel",
            "Roboto",
            "Open Sans",
            "Inter",
            "Lato",
            "Plus Jakarta Sans"
          ],
          "placeholder": "Vælg en optimeret skrifttype"
        },
        "type": "Select"
      },
      "custom_font_input": {
        "config": {
          "label": "Avanceret skrifttype (Bunny Fonts)",
          "placeholder": "Navn fra fonts.bunny.net (f.eks. \"Playfair Display\"). Dette felt overstyrer valget ovenfor."
        },
        "type": "Text"
      },
      "color_scheme": {
        "config": {
          "default_value": "Lys",
          "label": "Browser-tema (scrollbars + formularer)",
          "options": [
            "Lys",
            "Mørk",
            "Lys & mørk (auto)"
          ],
          "placeholder": "Hvilket tema browseren tilpasser sine egne kontroller til"
        },
        "type": "Select"
      },
      "text_scale": {
        "config": {
          "default_value": "Standard (16px)",
          "label": "Tekststørrelse",
          "options": [
            "Standard (16px)",
            "Stor (18px)",
            "Ekstra stor (20px)"
          ]
        },
        "type": "Select"
      },
      "paper_grain": {
        "config": {
          "default_value": "Fra",
          "label": "Papir-tekstur",
          "options": [
            "Fra",
            "Til"
          ],
          "placeholder": "Subtil kornet overflade over hele sitet"
        },
        "type": "Select"
      }
    },
    "Viderestillinger": {
      "redirects": {
        "config": {
          "fields": {
            "from_url": {
              "config": {
                "label": "Fra URL",
                "placeholder": "f.eks. /sommer"
              },
              "type": "Text"
            },
            "to_url": {
              "config": {
                "label": "Til URL",
                "placeholder": "f.eks. /tilbud"
              },
              "type": "Text"
            },
            "redirect_type": {
              "config": {
                "default_value": "301 (siden er slettet/flyttet for altid)",
                "label": "Hvorfor laver du dette link?",
                "options": [
                  "301 (siden er slettet/flyttet for altid)",
                  "307 (dette er blot en midlertidig genvej)"
                ],
                "placeholder": ""
              },
              "type": "Select"
            }
          },
          "label": "Viderestillinger",
          "repeat": true
        },
        "type": "Group"
      }
    }
  },
  "label": "Indstillinger",
  "repeatable": false,
  "status": true
}