{
  "id": "settings",
  "label": "Indstillinger",
  "repeatable": false,
  "json": {
    "Generelt": {
      "site_name": {
        "type": "Text",
        "config": {
          "label": "Sidenavn",
          "placeholder": "F.eks. Jensen Frisør"
        }
      },
      "force_lang_prefix": {
        "type": "Boolean",
        "config": {
          "label": "Tving sprog i URL? (fx /da-dk)",
          "default_value": false,
          "placeholder_true": "Ja",
          "placeholder_false": "Nej"
        }
      },
      "default_og_image": {
        "type": "Image",
        "config": {
          "label": "Standard billede (sociale medier)",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      },
      "favicon_light": {
        "type": "Image",
        "config": {
          "label": "Favicon — mørkt ikon (til lyst tema)",
          "placeholder": "Mørk streg/logo — vises på browserens LYSE faneblad",
          "constraint": {
            "width": 512,
            "height": 512
          },
          "thumbnails": []
        }
      },
      "favicon_dark": {
        "type": "Image",
        "config": {
          "label": "Favicon — lyst ikon (til mørkt tema)",
          "placeholder": "Lys streg/logo — vises på browserens MØRKE faneblad",
          "constraint": {
            "width": 512,
            "height": 512
          },
          "thumbnails": []
        }
      },
      "timezone": {
        "type": "Select",
        "config": {
          "label": "Tidszone",
          "placeholder": "Kundens tidszone",
          "default_value": "Europe/Copenhagen",
          "options": [
            "Europe/Copenhagen",
            "Europe/Oslo",
            "Europe/Stockholm",
            "Europe/Helsinki",
            "Europe/Berlin",
            "Europe/London",
            "UTC"
          ]
        }
      },
      "translate_brand": {
        "type": "Boolean",
        "config": {
          "label": "Tillad oversættelse af sitenavn (fx Google Translate)",
          "placeholder_true": "Tillad oversættelse",
          "placeholder_false": "Bevar originalt navn"
        }
      }
    },
    "Udseende og layout": {
      "color_light": {
        "type": "Color",
        "config": {
          "label": "Lys farve",
          "placeholder": ""
        }
      },
      "color_dark": {
        "type": "Color",
        "config": {
          "label": "Mørk farve",
          "placeholder": ""
        }
      },
      "color_primary": {
        "type": "Color",
        "config": {
          "label": "Primær brandfarve",
          "placeholder": ""
        }
      },
      "color_secondary": {
        "type": "Color",
        "config": {
          "label": "Sekundær brandfarve",
          "placeholder": ""
        }
      },
      "layout_width": {
        "type": "Select",
        "config": {
          "label": "Layoutbredde",
          "placeholder": "Bredden på dit hjemmesideindhold",
          "options": [
            "Klassisk (1200px)",
            "Standard (1280px)",
            "Moderne (1440px)",
            "Ekspansiv (1664px)",
            "Cinematic (1920px)"
          ]
        }
      },
      "border_radius": {
        "type": "Select",
        "config": {
          "label": "Hjørner / radius",
          "placeholder": "Hvor skarpe eller bløde kanterne skal være på fx kasser og billeder",
          "options": [
            "Skarpe hjørner (0px)",
            "Lille afrunding (4px)",
            "Standard (8px)",
            "Blød (16px)",
            "Pilleformet (fuld radius)"
          ]
        }
      },
      "font_select": {
        "type": "Select",
        "config": {
          "label": "Skrifttype (anbefalet - hurtig)",
          "placeholder": "Vælg en optimeret skrifttype",
          "default_value": "System standard",
          "options": [
            "System standard",
            "Montserrat",
            "Rethink Sans",
            "Comfortaa",
            "Poppins",
            "Abel",
            "Roboto",
            "Open Sans",
            "Inter",
            "Lato",
            "Plus Jakarta Sans"
          ]
        }
      },
      "custom_font_input": {
        "type": "Text",
        "config": {
          "label": "Avanceret skrifttype (Bunny Fonts)",
          "placeholder": "Navn fra fonts.bunny.net (f.eks. \"Playfair Display\"). Dette felt overstyrer valget ovenfor."
        }
      },
      "color_scheme": {
        "type": "Select",
        "config": {
          "label": "Browser-tema (scrollbars + formularer)",
          "placeholder": "Hvilket tema browseren tilpasser sine egne kontroller til",
          "default_value": "Lys",
          "options": [
            "Lys",
            "Mørk",
            "Lys & mørk (auto)"
          ]
        }
      }
    },
    "Viderestillinger": {
      "redirects": {
        "type": "Group",
        "config": {
          "label": "Viderestillinger",
          "repeat": true,
          "fields": {
            "from_url": {
              "type": "Text",
              "config": {
                "label": "Fra URL",
                "placeholder": "f.eks. /sommer"
              }
            },
            "to_url": {
              "type": "Text",
              "config": {
                "label": "Til URL",
                "placeholder": "f.eks. /tilbud"
              }
            },
            "redirect_type": {
              "type": "Select",
              "config": {
                "label": "Hvorfor laver du dette link?",
                "placeholder": "",
                "default_value": "301 (siden er slettet/flyttet for altid)",
                "options": [
                  "301 (siden er slettet/flyttet for altid)",
                  "307 (dette er blot en midlertidig genvej)"
                ]
              }
            }
          }
        }
      }
    }
  },
  "status": true,
  "format": "custom"
}